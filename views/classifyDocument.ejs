<!DOCTYPE html>
<html lang="pt">
<head>
	<meta charset="UTF-8" />
	<title>Classificar Documento</title>
	<style>
		.positive {
			color: green;
			font-weight: bold;
		}
		.negative {
			color: red;
			font-weight: bold;
		}
		.feedback-buttons {
			margin-top: 10px;
		}
		.feedback-buttons button {
			padding: 8px 16px;
			font-size: 14px;
			margin-right: 10px;
			border: none;
			cursor: pointer;
			border-radius: 4px;
		}
		.feedback-buttons .correct {
			background-color: #4CAF50;
			color: white;
		}
		.feedback-buttons .wrong {
			background-color: #f44336;
			color: white;
		}
	</style>
</head>
<body>
	<h1>Classificar Documento</h1>

	<form action="/classifyDocument" method="post">
		<textarea
			name="text"
			rows="6"
			cols="60"
			placeholder="Insira uma review para ser classificada..."
			required
		><%= inputText || '' %></textarea><br />
		<button type="submit">Classificar</button>
	</form>

	<% if (cosineResult) { %>
		<h2>Resultado pela Similaridade Cosseno:</h2>
		<p>
			<strong>Classe Prevista:</strong>
			<span class="<%= cosineResult.class === 'positive' ? 'positive' : 'negative' %>">
				<%= cosineResult.class %>
			</span>
		</p>
		<p><strong>Similaridade:</strong> <%= cosineResult.similarity.toFixed(4) %></p>
	<% } %>

	<% if (probabilisticResult) { %>
		<h2>Resultado pela Classificação Probabilística:</h2>
		<p>
			<strong>Classe Prevista:</strong>
			<span class="<%= probabilisticResult.class === 'positive' ? 'positive' : 'negative' %>">
				<%= probabilisticResult.class %>
			</span>
		</p>
		<p><strong>Probabilidade</strong> <%= probabilisticResult.probability.toFixed(4) %></p>
	<% } %>

	<!-- Botões de feedback -->
	<div class="feedback-buttons">
		<% if (cosineResult) { %>
		<form action="/classifyDocument/feedback" method="post" style="display:inline;">
			<input type="hidden" name="text" value="<%= inputText %>" />
			<input type="hidden" name="predictedClass" value="<%= cosineResult.class %>" />
			<label>Classe real:
			<select name="realClass" required>
				<option value="">--Selecionar--</option>
				<option value="positive">Positive</option>
				<option value="negative">Negative</option>
			</select>
			</label>
			<button type="submit" class="correct">Submeter</button>
		</form>
		<% } %>
	</div>

    <br />

	<!-- Links -->
	<a href="/train">2. Treinar Modelo</a>
	<br />
	<a href="/stats">4. Estatísticas</a>
</body>
</html>
