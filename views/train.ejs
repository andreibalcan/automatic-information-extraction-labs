<!DOCTYPE html>
<html lang="pt">
	<head>
		<meta charset="UTF-8" />
		<title>Treinar Modelo</title>
		<style>
			#spinner {
				border: 4px solid #f3f3f3;
				border-top: 4px solid #333;
				border-radius: 50%;
				width: 24px;
				height: 24px;
				animation: spin 1s linear infinite;
				display: none;
				vertical-align: middle;
				margin-right: 10px;
			}
			@keyframes spin {
				0% {
					transform: rotate(0deg);
				}
				100% {
					transform: rotate(360deg);
				}
			}
			#links {
				margin-top: 20px;
				display: none;
			}
		</style>
	</head>
	<body>
		<h1>Treinar Modelo</h1>

		<button id="startButton">Iniciar Treino</button>

		<p id="status" style="display: none">
			<span id="spinner"></span>
			<span id="status-text"></span>
			<span id="timer">0.0s</span>
		</p>

		<div id="links">
			<a href="/classifyDocument">3. Classificar Novo Documento</a><br />
			<a href="/stats">4. Estatísticas</a>
		</div>

		<pre id="json" style="display: none"></pre>

		<script>
			const startButton = document.getElementById("startButton");
			const spinner = document.getElementById("spinner");
			const statusText = document.getElementById("status-text");
			const timerEl = document.getElementById("timer");
			const status = document.getElementById("status");
			const jsonEl = document.getElementById("json");
			const links = document.getElementById("links");

			let timerInterval;

			startButton.addEventListener("click", () => {
				// Reset UI
				startButton.disabled = true;
				status.style.display = "inline";
				spinner.style.display = "inline-block";
				statusText.textContent = "A treinar modelo...";
				timerEl.textContent = "0.0s";
				links.style.display = "none";
				jsonEl.style.display = "none";

				let startTime = performance.now();
				timerInterval = setInterval(() => {
					let now = performance.now();
					let seconds = ((now - startTime) / 1000).toFixed(1);
					timerEl.textContent = `${seconds}s`;
				}, 100);

				fetch("/train/run")
					.then((res) => {
						if (!res.ok) throw new Error("Erro ao treinar modelo.");
						return res.json();
					})
					.then(() => {
						clearInterval(timerInterval);
						spinner.style.display = "none";
						statusText.textContent =
							"Treino do modelo concluído, verifique o ficheiro train_results.json.";
						timerEl.textContent = "";
						links.style.display = "block";
						startButton.disabled = false;
					})
					.catch((err) => {
						clearInterval(timerInterval);
						spinner.style.display = "none";
						statusText.textContent = "Erro ao treinar modelo.";
						console.error(err);
						startButton.disabled = false;
					});
			});
		</script>
	</body>
</html>
