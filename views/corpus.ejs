<!DOCTYPE html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Top 100 Reviews - <%= label %></title>
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="bg-white text-foreground min-h-screen px-4 py-12">
    <div class="max-w-4xl mx-auto space-y-8">
      <h1 class="text-2xl font-semibold tracking-tight text-center text-neutral-950">
        Top 100 Reviews - <%= label %>
      </h1>

      <ul class="space-y-6">
        <% reviews.forEach(review => { %>
          <li class="border border-neutral-200 rounded-lg p-4 shadow-sm bg-white">
            <p class="text-sm text-neutral-700 mb-2">
              <strong class="text-neutral-800">ID:</strong>
              <%= review.id || 'N/A' %>
            </p>
            <p class="text-sm text-neutral-700 mb-2">
              <strong class="text-neutral-800">Descrição:</strong>
              <%= review.description || 'Sem comentário' %>
            </p>
            <p class="text-sm text-neutral-700 mb-1">
              <strong class="text-neutral-800">Label:</strong>
              <span class="<%= review.label === 'positive' ? 'text-green-600 font-semibold' : 'text-red-600 font-semibold' %>">
                <%= review.label || 'N/A' %>
              </span>
            </p>
            <p class="text-sm text-neutral-700">
              <strong class="text-neutral-800">Score:</strong>
              <%= review.score || 'N/A' %>
            </p>
          </li>
        <% }); %>
      </ul>
    </div>
  </body>
</html>
