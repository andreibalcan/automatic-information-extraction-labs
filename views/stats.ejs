<!DOCTYPE html>
<html lang="pt">
	<head>
		<meta charset="UTF-8" />
		<title>Estatísticas</title>
	</head>
	<body>
		<h1>Estatísticas</h1>
		<% if (message) { %>
		<p><%= message %></p>
		<% } else { %>
		<h2>Matriz de Confusão</h2>
		<table
			border="1"
			cellpadding="5"
			style="border-collapse: collapse; text-align: center"
		>
			<thead>
				<tr>
					<th></th>
					<th colspan="<%= matrix.classes.length %>">Real</th>
				</tr>
				<tr>
					<th></th>
					<% matrix.classes.forEach(cls => { %>
					<th><%= cls %></th>
					<% }); %>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td rowspan="<%= matrix.classes.length %>">Previsto</td>
					<% matrix.classes.forEach((predClass, rowIndex) => { %> <%
					if (rowIndex > 0) { %>
				</tr>
				<tr>
					<% } %>
					<td><strong><%= predClass %></strong></td>
					<% matrix.matrix[rowIndex].forEach(count => { %>
					<td><%= count %></td>
					<% }); %> <% }); %>
				</tr>
			</tbody>
		</table>
		<br />
		<h2>Métricas</h2>
		<% matrix.classes.forEach(cls => { %>

		<h3>Classe <strong><%= cls %></strong>:</h3>
		<p>
			<strong>Precisão:</strong> <%= (precisions[cls] * 100).toFixed(2)
			%>%
		</p>
		<p><strong>Recall:</strong> <%= (recalls[cls] * 100).toFixed(2) %>%</p>
		<p>
			<strong>F1-Score:</strong> <%= (f1scores[cls] * 100).toFixed(2) %>%
		</p>
		<br />
		<% }); %> <% } %>
	</body>
</html>
