<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-white">
  <div
    class="w-full max-w-xl bg-white border border-red-200 rounded-2xl shadow-md p-8 space-y-6"
  >
    <h1 class="text-2xl font-semibold text-red-600 text-center">
      <%= message %>
    </h1>

    <h2 class="text-lg font-medium text-red-500 text-center">
      Erro <%= error.status %>
    </h2>

    <pre
      class="text-sm text-neutral-800 bg-red-50 border border-red-100 rounded-md p-4 overflow-x-auto whitespace-pre-wrap"
    >
<%= error.stack %>
    </pre>
  </div>
</div>
